# ============================================================
# 火山方舟（图片 + 文字对话）共用 API Key
# 复制本文件为 .env.local 后填写真实值，勿提交 .env.local
# ============================================================
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Vercel 等海外环境请改为 Cloudflare Worker 反代地址，并配置：
# ARK_BASE_URL=https://zhipiannvyou-ark-proxy.zhipiannvyou.workers.dev/api/v3
# ARK_PROXY_SECRET=

# 图片：在线推理里的 Seedream 接入点（ep-m-xxxx）
ARK_SEEDREAM_MODEL=

# 文字对话：在线推理里的文字模型接入点（ep-m-xxxx）
ARK_LLM_MODEL=

# ============================================================
# Cloudflare R2（AI 生成图片永久存储，仅服务端）
# ============================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 可省略，默认 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ============================================================
# Cloudflare D1 聊天存储（经 Worker，仅服务端）
# ============================================================
CHAT_STORE_URL=https://zhipiannvyou-chat-store.zhipiannvyou.workers.dev
CHAT_STORE_SECRET=

# ============================================================
# cron-job.org（外部定时闹钟）
# 控制台: https://console.cron-job.org/ → Settings 创建 API Key
# 文档: https://docs.cron-job.org/rest-api.html
# ============================================================
CRON_JOB_API_KEY=
CRON_JOB_API_BASE_URL=https://api.cron-job.org
# 保护本站定时接口，cron 请求头需带 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ============================================================
# Resend（欢迎邮件等，仅服务端）
# 控制台: https://resend.com/ → API Keys 创建
# 文档: https://resend.com/docs
# ============================================================
RESEND_API_KEY=
# 测试阶段可用: onboarding@resend.dev
# 正式环境改为已验证域名邮箱，例如: 雅琪 <noreply@你的域名.com>
RESEND_FROM_EMAIL=onboarding@resend.dev
# Resend 已发布模板的 Alias / ID
RESEND_WELCOME_TEMPLATE_ID=untitled-template

# ============================================================
# Crisp（站内客服聊天气泡，客户端公开）
# 控制台: https://app.crisp.chat/ → Settings → Workspace Settings → Setup & Integrations
# 文档: https://help.crisp.chat/en/article/how-to-install-crisp-chat-widget-on-nextjs-app-xh9yse/
# ============================================================
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ============================================================
# 扣子（语音 TTS 等，可选）
# ============================================================
COZE_API_TOKEN=
COZE_WORKLOAD_IDENTITY_API_KEY=
COZE_INTEGRATION_BASE_URL=https://api.coze.cn
COZE_INTEGRATION_MODEL_BASE_URL=https://api.coze.cn

# ============================================================
# 项目运行
# ============================================================
COZE_PROJECT_ENV=DEV
COZE_PROJECT_DOMAIN_DEFAULT=http://localhost:3000
PORT=3000
